{
  "name": "promptstudio",
  "version": "0.1.0",
  "description": "AI creative studio for Windows: text, image, voice and video generation through OpenRouter",
  "main": "./out/main/index.js",
  "author": "PromptStudio",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:win": "electron-vite build && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
